# Copy to .env.local. Never commit .env.local.

# Local ComfyUI through comfy-api-proxy (default). Leave COMFY_API_KEY empty.
COMFY_BASE_URL=http://127.0.0.1:8189
COMFY_API_KEY=

# ComfyUI itself, read for the machine's RAM and GPU memory so each engine's clip length fits this machine
# (the proxy does not pass /system_stats on). Leave it empty for a Comfy API deployment: the fixed caps apply.
COMFYUI_URL=http://127.0.0.1:8188

# Your own Comfy API deployment of these workflows (a Build with the node packs and models):
# COMFY_BASE_URL=https://<deployment>.run.comfy.app
# COMFY_API_KEY=comfyui-...
