# Copy to .env.local. Never commit .env.local.

# Local ComfyUI through comfy-api-proxy (default). Leave COMFY_API_KEY empty.
COMFY_BASE_URL=http://127.0.0.1:8189
COMFY_API_KEY=

# Hosted: a Comfy API deployment. Set both, leave COMFY_BASE_URL empty.
# COMFY_API_KEY=comfyui-...
# COMFY_DEPLOYMENT_ID=
